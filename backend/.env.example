# ==========================================================================
# SKYVOYAGE INDIA - SECURE SERVER ENVIRONMENT VARIABLES
# Rename this file to .env and input your actual live secrets before running
# ==========================================================================

# 1. Server Configuration
PORT=5000
NODE_ENV=development

# 2. Database Dialect Choice ('mysql' or 'postgres')
DB_DIALECT=mysql

# 3. Database Credentials (For MySQL / XAMPP Default Setup)
DB_HOST=127.0.0.1
DB_PORT=3306
DB_USER=root
DB_PASS=
DB_NAME=skyvoyage_db

# 4. Alternative: Database Credentials (For Production PostgreSQL / Linux VPS VPS)
# DB_HOST=localhost
# DB_PORT=5432
# DB_USER=postgres
# DB_PASS=your_vps_db_password
# DB_NAME=skyvoyage_production_db

# 5. Live Merchant Integration (Razorpay Credentials obtained from Dashboard)
RAZORPAY_KEY_ID=rzp_test_yourKeyIdHere
RAZORPAY_KEY_SECRET=yourRazorpaySecretKeyHere

# 6. Live Travel Aggregator (TBO / Amadeus Integration Endpoint details)
TRAVEL_API_ENDPOINT=https://api.tboholidays.com/xml/
TRAVEL_API_CLIENT_ID=yourTBOClientId
TRAVEL_API_PASSWORD=yourTBOPassword
